############################################################
# 이 파일을 secrets.auto.tfvars 로 복사한 뒤 값을 채운다.
#
#   cp secrets.auto.tfvars.example secrets.auto.tfvars
#
# 왜 terraform.tfvars 가 아니라 별도 파일인가:
#   terraform.tfvars 는 git 에 "추적 중"이라 거기 적은 값은 그대로 커밋되고
#   히스토리에 영구히 남는다. .gitignore 의 *.tfvars 는 이미 추적 중인 파일에는
#   적용되지 않는다. secrets.auto.tfvars 는 추적된 적이 없어서 실제로 무시된다.
#   (.auto.tfvars 로 끝나면 terraform 이 자동으로 읽어준다 — -var-file 불필요)
#
# 이 파일(.example)은 값이 없으므로 git 에 올라간다. 값이 든 secrets.auto.tfvars 는
# 절대 커밋하지 말 것.
#
# ⚠ secrets.auto.tfvars 는 git 에 없으므로 새 컴퓨터에는 존재하지 않는다.
#   백업해두거나, 아래 값들을 팀 비밀번호 관리자 같은 안전한 곳에 보관할 것.
############################################################

# ---- 구글 OAuth 클라이언트 시크릿 (필수) ----
#
# 기본값이 없어서 이 값이 없으면 apply 가 아예 멈춘다. 의도된 동작이다 —
# 빈 값으로 조용히 성공해서 Secrets Manager 를 덮어쓰는 것보다 낫다(oauth.tf 참고).
#
# 이미 한 번이라도 apply 한 스택이 살아 있다면 거기서 꺼내 쓸 수 있다:
#   $env:TF_VAR_google_client_secret = (aws secretsmanager get-secret-value `
#     --secret-id cloud-duck/app/auth --region ap-northeast-2 `
#     --query "SecretString" --output text | ConvertFrom-Json).google_client_secret
#
# 완전히 새로 만드는 경우엔 구글 클라우드 콘솔에서 발급받는다.
google_client_secret = "GOCSPX-..."

# ---- 카카오 client_secret (선택) ----
# 카카오 콘솔에서 '사용함'으로 켠 경우에만 필요하다. 안 쓰면 줄째로 지운다.
# kakao_client_secret = "..."

# ---- 관리자 비밀번호 (선택) ----
#
# admin@cloudduck.cloud 로 로그인할 때 쓰는 값. 비워두면 20 자 랜덤이 자동 생성되고,
# 그때는 Secrets Manager 에서 확인해야 한다:
#   aws secretsmanager get-secret-value --secret-id cloud-duck/admin/credentials `
#     --region ap-northeast-2 --query SecretString --output text
#
# ⚠ 이 값은 시크릿이 "처음 만들어질 때"만 쓰인다.
#   이미 만들어져 있는 스택에서는 여기를 고쳐도 반영되지 않는다
#   (admin-credentials.tf 의 ignore_changes — 값을 갖지 않은 팀원의 apply 가
#    비밀번호를 조용히 되돌리는 걸 막기 위한 것이다).
#   이미 있는 비밀번호를 바꾸는 방법은 admin-credentials.tf 주석에 적어뒀다.
#
# 즉 여기 적는 게 의미 있는 건 destroy 후 재구축이나 최초 구축 때다.
# admin_password = "..."
