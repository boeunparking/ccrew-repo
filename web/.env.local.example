# 로컬 개발용 환경변수 템플릿.
#
#   cp .env.local.example .env.local     (PowerShell: copy .env.local.example .env.local)
#   값을 채우고
#   npm run dev
#
# .env.local 은 .gitignore 대상이라 실제 값이 커밋되지 않는다.
# 배포 환경은 이 파일을 쓰지 않는다 — ECS task definition이 환경변수를 직접 주입한다.

# ---- 로컬 MySQL ----
# 데이터베이스와 테이블은 서버가 부팅하면서 알아서 만든다(src/schema.js).
# 미리 CREATE DATABASE 할 필요 없다.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cloud_duck

# ---- 인증 (Cognito) ----
# 회원가입/로그인/구글 연동은 이 서버가 하지 않는다 — 프론트가 Cognito를 직접
# 호출해서 ID 토큰을 받아오고, 이 서버는 그 토큰을 검증만 한다. 아래 값은
# `terraform output cognito_frontend_contract`로 확인한다.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# ---- Valkey ----
# 입찰/실시간 기능을 보려면 Valkey를 띄우고 아래를 켠다. 비워두면 그 기능만 빠진다.
# REDIS_URL=redis://localhost:6379
