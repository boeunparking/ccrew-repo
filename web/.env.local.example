# 로컬 개발용 환경변수 템플릿.
#
#   cp .env.local.example .env.local     (PowerShell: copy .env.local.example .env.local)
#   값을 채우고
#   npm run dev
#
# .env.local 은 .gitignore 대상이라 실제 값이 커밋되지 않는다.
# 배포 환경은 이 파일을 쓰지 않는다 — ECS task definition이 환경변수를 직접 주입한다.

# ---- 로컬 MySQL ----
# 데이터베이스와 테이블은 서버가 부팅하면서 알아서 만든다(src/schema.js).
# 미리 CREATE DATABASE 할 필요 없다.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cloud_duck

# ---- 소셜 로그인 ----
# 아래 콜백 주소를 구글/카카오 콘솔의 Redirect URI에 **추가로** 등록해야 한다.
# (운영용 https://api.cloudduck.cloud/... 는 그대로 두고 하나 더 넣는 것)
#   http://localhost:3000/auth/oauth/google/callback
#   http://localhost:3000/auth/oauth/kakao/callback
PUBLIC_API_BASE_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_REST_API_KEY=
# 카카오 콘솔에서 '사용함'으로 켠 경우에만
# KAKAO_CLIENT_SECRET=

# ---- 토큰 서명 ----
# 로컬 전용 값. 운영 키는 Secrets Manager가 주입한다.
JWT_SECRET=local-dev-only-change-me

# ---- Valkey ----
# 비워두면 OAuth state를 프로세스 메모리에 둔다 — 로컬에 Redis를 안 띄워도
# 소셜 로그인을 테스트할 수 있다. 입찰/실시간 기능까지 보려면 Valkey를 띄우고 아래를 켠다.
# REDIS_URL=redis://localhost:6379

# ---- 관리자 계정 시드 ----
# 둘 중 하나라도 비면 시드를 건너뛴다.
ADMIN_EMAIL=admin@cloudduck.cloud
ADMIN_PASSWORD=admin1234
